# ============================================================
# Rotulai API: variáveis de ambiente
# Copie para backend/.env e ajuste. NUNCA versione o arquivo .env.
# ============================================================

NODE_ENV=development
PORT=3333

# Banco PostgreSQL (o docker-compose.yml da raiz cria este usuário/banco)
DATABASE_URL=postgresql://rotulai:rotulai@localhost:5432/rotulai
# Banco usado pelos testes automatizados (opcional; este é o padrão).
# Use somente um banco isolado: os testes limpam as tabelas de teste entre casos. Nunca use produção.
TEST_DATABASE_URL=postgresql://rotulai:rotulai@localhost:5432/rotulai_test

# Origens do front-end autorizadas (separadas por vírgula)
CORS_ORIGINS=http://localhost:5173
# Proxies confiáveis à frente da API (use 1 em Render/Railway/Fly)
TRUST_PROXY=0
# Segredo opcional de pelo menos 32 caracteres para proteger /api/cron/retention.
# Necessário somente quando uma rotina agendada externa/Vercel Cron chamar o endpoint.
# CRON_SECRET=

# Autenticação
# Gere um segredo forte, por exemplo: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=troque-por-um-segredo-aleatorio-com-pelo-menos-32-caracteres
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7
# Em produção com front e API em domínios diferentes: COOKIE_SAMESITE=none e COOKIE_SECURE=true
COOKIE_SAMESITE=lax
# COOKIE_SECURE=true
BCRYPT_ROUNDS=12
# Bootstrap do primeiro administrador. Preencha apenas no ambiente local/deploy e limpe após executar.
# O comando npm run admin:bootstrap -w backend não altera senha de uma conta existente.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# Inteligência artificial (somente no servidor)
# AI_PROVIDER=anthropic | none
AI_PROVIDER=anthropic
# Chave da API Anthropic: https://console.anthropic.com/  (deixe vazio para desabilitar a IA)
ANTHROPIC_API_KEY=
AI_MODEL=claude-haiku-5-5
AI_TIMEOUT_MS=30000
AI_MAX_OUTPUT_TOKENS=1024
AI_MAX_INPUT_CHARS=2000
AI_HISTORY_MESSAGES=12
AI_RATE_LIMIT_PER_MINUTE=10
AI_DAILY_LIMIT_PER_USER=100

# Retenção do histórico (dias)
HISTORY_RETENTION_DAYS=180

LOG_LEVEL=info
