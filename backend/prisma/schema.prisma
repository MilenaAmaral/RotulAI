// Modelo de dados do Rotulai.
// Dados privados (produtos, históricos, conversas) pertencem sempre a um User
// e são removidos em cascata quando a conta é excluída.
// Ingredient é um catálogo global e compartilhado para evitar duplicação.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

enum ProductCategory {
  LIMPEZA
  TONICO
  SERUM
  HIDRATANTE
  PROTETOR_SOLAR
  ESFOLIANTE
  MASCARA
  OLHOS
  LABIOS
  TRATAMENTO
  OUTRO
}

enum MessageRole {
  USER
  ASSISTANT
}

enum AiFeature {
  CHAT
  INGREDIENT_EXPLANATION
  COMPARISON_EXPLANATION
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  name         String   @db.VarChar(80)
  email        String   @unique @db.VarChar(254)
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  refreshTokens      RefreshToken[]
  products           Product[]
  ingredientAnalyses IngredientAnalysis[]
  comparisons        ProductComparison[]
  conversations      Conversation[]
  aiUsage            AiUsageLog[]
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  // Apenas o hash SHA-256 do token é persistido.
  tokenHash String    @unique @db.Char(64)
  // Tokens da mesma família compartilham familyId (rotação com detecção de reuso).
  familyId  String    @db.Uuid
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
}

model Product {
  id           String          @id @default(uuid()) @db.Uuid
  userId       String          @db.Uuid
  name         String          @db.VarChar(120)
  brand        String          @db.VarChar(80)
  category     ProductCategory
  description  String?         @db.VarChar(2000)
  imageUrl     String?         @db.VarChar(500)
  // Página pública de onde a lista de ingredientes foi obtida, para conferência.
  referenceUrl String?         @db.VarChar(500)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  user        User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  ingredients ProductIngredient[]

  @@index([userId, createdAt])
  @@index([userId, category])
}

model Ingredient {
  id             String   @id @default(uuid()) @db.Uuid
  // Nome de exibição (geralmente a nomenclatura INCI).
  name           String   @db.VarChar(120)
  // Nome normalizado (minúsculas, espaços colapsados) usado para evitar duplicação.
  normalizedName String   @unique @db.VarChar(120)
  synonyms       String[]
  // Sinônimos normalizados para busca exata.
  searchTerms    String[]
  functions      String[]
  description    String?
  usageInfo      String?
  cautions       String?
  // true = conteúdo revisado na base de referência do projeto.
  // false = ingrediente criado a partir de um rótulo, sem informações verificadas.
  isCurated      Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  sources  IngredientSource[]
  products ProductIngredient[]
  analyses IngredientAnalysis[]

  @@index([searchTerms], type: Gin)
}

model IngredientSource {
  id           String  @id @default(uuid()) @db.Uuid
  ingredientId String  @db.Uuid
  title        String  @db.VarChar(200)
  publisher    String  @db.VarChar(120)
  url          String  @db.VarChar(500)
  note         String? @db.VarChar(300)

  ingredient Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)

  @@index([ingredientId])
}

model ProductIngredient {
  productId    String @db.Uuid
  ingredientId String @db.Uuid
  // Posição no rótulo (a ordem INCI costuma refletir concentração decrescente).
  position     Int

  product    Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  ingredient Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Restrict)

  @@id([productId, ingredientId])
  @@index([ingredientId])
}

model IngredientAnalysis {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @db.Uuid
  ingredientId   String?  @db.Uuid
  query          String   @db.VarChar(120)
  foundInCatalog Boolean
  aiExplanation  String?
  aiModel        String?  @db.VarChar(80)
  createdAt      DateTime @default(now())

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  ingredient Ingredient? @relation(fields: [ingredientId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
}

model ProductComparison {
  id            String   @id @default(uuid()) @db.Uuid
  userId        String   @db.Uuid
  productAId    String?  @db.Uuid
  productBId    String?  @db.Uuid
  // Resultado determinístico congelado no momento da comparação.
  result        Json
  aiExplanation String?
  aiModel       String?  @db.VarChar(80)
  createdAt     DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model Conversation {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  title     String   @db.VarChar(120)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages Message[]

  @@index([userId, updatedAt])
}

model Message {
  id             String      @id @default(uuid()) @db.Uuid
  conversationId String      @db.Uuid
  role           MessageRole
  content        String
  model          String?     @db.VarChar(80)
  createdAt      DateTime    @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

// Registro de uso da IA para limite diário por usuário.
// Não é apagado junto com o histórico, para que excluir conversas não zere a cota.
model AiUsageLog {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  feature   AiFeature
  success   Boolean
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}
